{
  "name": "picisa",
  "version": "1.3.0",
  "description": "Picasa replacement in pure JS",
  "author": "Jocelyn Turpault (turpault@gmail.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/turpault/my-picasa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:turpault/my-picasa.git"
  },
  "build": {
    "files": [
      "dist/**/*",
      "!src"
    ]
  },
  "testGlob": "./dist/test/**/*.spec.js?(x)",
  "homepage": "https://github.com/turpault/my-picasa#readme",
  "keywords": [
    "typescript",
    "picasa",
    "album",
    "photoshop",
    "gallery",
    "tdd"
  ],
  "main": "server/index.ts",
  "browser": "public/dist/index.html",
  "scripts": {
    "clean": "rimraf dist picisa.dmg",
    "reset": "rimraf node_modules dist",
    "prebuild": "bun run clean; mkdir dist ; cp -R public dist",
    "build": "bun run scripts/build.ts",
    "check:no-internal-imports": "bun run scripts/check-no-internal-imports.ts",
    "build:client": "bun build public/index.html --minify --outdir=public/dist",
    "build:icons": "png2icons resources/picisa.png resources/picisa -icns",
    "build:ico": "png2icons resources/picisa.png public/favicon -ico",
    "build:splashbase64url": "bun server/toBase64Url.mjs public/resources/images/splash.png",
    "native-filters": "cd server/imageOperations/native-filters && bun run configure && bun run build",
    "prestart": "bun run native-filters",
    "dev": "DEBUG=app:* NODE_ENV=development DEBUG='*' PICISA_PICTURE_FOLDER=/Volumes/1TB\\ USB/Photos bun --hot server/index.ts",
    "start": "bun --watch server/index.ts",
    "start:server": "DEBUG='*' PICISA_PICTURE_FOLDER=/Volumes/1TB\\ USB/Photos bun --watch server/index.ts",
    "predeploy": "bun run build",
    "deploy": "bun x run-p deploy:*",
    "deploy:webapp": "rm -rf deployed ; cp -R public deployed; sudo cp com.turpault.picisa.plist /Library/LaunchDaemons && sudo chmod 600 /Library/LaunchDaemons/com.turpault.picisa.plist ; sudo launchctl unload /Library/LaunchDaemons/com.turpault.picisa.plist ; sudo launchctl load /Library/LaunchDaemons/com.turpault.picisa.plist"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/heic-decode": "^1.1.3",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.10",
    "npm-run-all": "^4.1.5",
    "png2icons": "^2.0.1"
  },
  "dependencies": {
    "@sentry/browser": "^8.32.0",
    "@sentry/node": "^8.32.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "chalk": "^4.0.0",
    "csv-parser": "^3.0.0",
    "debug": "^4.3.7",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "heic-decode": "^2.1.0",
    "image-size": "^1.1.1",
    "js-base64": "^3.7.7",
    "leaflet": "^1.9.4",
    "panzoom": "^9.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.33.5",
    "ts-2d-geometry": "^6.3.5",
    "xml2js": "^0.6.2"
  }
}